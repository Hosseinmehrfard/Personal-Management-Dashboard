DOMAIN=dashboard.example.com
SETUP_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CODE
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
DATA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARS
DATABASE_URL=postgres://markaz:REPLACE_WITH_RANDOM_PASSWORD@db:5432/markaz

# In HTTPS mode, pin the public origin to the configured domain.
PUBLIC_ORIGIN=
# Blank disables remote server polling until an administrator allowlists hostnames here.
ALLOWED_AGENT_HOSTS=
